#!/bin/bash
# Pre-push hook to check if versions have changed before allowing push
# This prevents pushing changes when neither rod_derive nor rod_validation versions have changed

# Get the remote SHA1 from arguments
# $1 = local ref, $2 = local sha1, $3 = remote ref, $4 = remote sha1
remote_sha1="$4"
local_sha1="$2"

# Get the list of files changed in the commits being pushed
cargo_changed=$(git diff --name-only "$remote_sha1" "$local_sha1" 2>/dev/null | grep -i "Cargo.toml")

# Check if any Cargo.toml files have changed
if [ -z "$cargo_changed" ]; then
    echo "No changes detected in Cargo.toml files."
    echo "Nothing to push - versions have not changed."
    exit 1
fi

# Check if versions were actually incremented
# Get the current versions from the working directory
get_version() {
    local file="$1"
    grep "^version" "$file" | head -1 | sed 's/version *= *"\(.*\)"/\1/'
}

rod_version=$(get_version "Cargo.toml")
rod_derive_version=$(get_version "rod_derive/Cargo.toml")

# Get the previous versions from the remote commit
rod_version_old=$(git show "$remote_sha1:Cargo.toml" 2>/dev/null | grep "^version" | head -1 | sed 's/version *= *"\(.*\)"/\1/')
rod_derive_version_old=$(git show "$remote_sha1:rod_derive/Cargo.toml" 2>/dev/null | grep "^version" | head -1 | sed 's/version *= *"\(.*\)"/\1/')

# Check if versions changed
rod_version_changed=false
rod_derive_version_changed=false

if [ "$rod_version" != "$rod_version_old" ]; then
    rod_version_changed=true
fi

if [ "$rod_derive_version" != "$rod_derive_version_old" ]; then
    rod_derive_version_changed=true
fi

# If neither version changed, fail the push
if [ "$rod_version_changed" = false ] && [ "$rod_derive_version_changed" = false ]; then
    echo "No changes detected in Cargo.toml files."
    echo "Nothing to push - versions have not changed."
    exit 1
fi

echo "Version check passed. Proceeding with push..."
